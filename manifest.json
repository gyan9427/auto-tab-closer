{
    "manifest_version": 3,
    "name": "Auto Tab Closer",
    "version": "1.1",
    "description": "Automatically closes inactive and off-topic tabs after a specified duration using local relevance analysis.",
    "permissions": [
        "tabs",
        "scripting",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}